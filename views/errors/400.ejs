<%- include('../partials/header', { title: title }) %>

<section class="error-page">
  <div class="error-card">
    <div class="error-illustration" aria-hidden="true">
      <i data-lucide="message-square-warning" class="error-icon"></i>
    </div>
    <div class="error-status">400</div>

    <h1 class="error-title">Bad Request</h1>
    <p class="error-description"> The request couldn't be understood or processed. Please check your request and try again. </p>

    <div class="error-divider"></div>

    <div class="error-actions">
      <a class="btn btn-accent" href="/">
        <i data-lucide="home" aria-hidden="true"></i>
        <span>Back to home</span>
      </a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
