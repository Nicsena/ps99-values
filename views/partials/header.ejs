<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('ps99-theme') || 'dark';
        if (t === 'light' || (t === 'system' && window.matchMedia('(prefers-color-scheme: light)').matches)) {
          document.documentElement.dataset.theme = 'light';
        }
      } catch (e) { /* localStorage unavailable — default dark */ }
    })();
  </script>
  <script src="/js/format.js" defer></script>
  <script src="https://unpkg.com/lucide@1.41.0/dist/umd/lucide.min.js" integrity="sha256-/D7Cdm/d++JpBay9Okbiuteo+Kx+9fMONwe1q7dQz5o=" crossorigin="anonymous"></script>
  <script src="/js/search.js" defer></script>
</head>
<body>
<%- include('navbar') %>

  <main class="container">
  <script>
    (function () {
      'use strict';

      function hasIcon(name) {
        try {
          return !!(window.lucide && lucide.icons && lucide.icons[
            name.split('-').map(function (p) { return p.charAt(0).toUpperCase() + p.slice(1); }).join('')
          ]);
        } catch (e) { return false; }
      }

      var FALLBACKS = {
        'line-chart': ['line-chart', 'chart-line', 'trending-up'],
        'bar-chart-3': ['bar-chart-3', 'chart-column', 'bar-chart-2'],
        'candlestick-chart': ['candlestick-chart', 'candlestick', 'bar-chart-2'],
        'area-chart': ['area-chart', 'waves'],
        'table-2': ['table-2', 'table'],
        'pie-chart': ['pie-chart', 'chart-pie']
      };

      function bestName(name) {
        var chain = [name].concat(FALLBACKS[name] || []);
        for (var i = 0; i < chain.length; i++) {
          if (hasIcon(chain[i])) return chain[i];
        }
        return chain[chain.length - 1];
      }

      function renderIcons() {
        if (!window.lucide || typeof lucide.createIcons !== 'function') return;
        document.querySelectorAll('i[data-lucide]').forEach(function (el) {
          el.setAttribute('data-lucide', bestName(el.getAttribute('data-lucide')));
        });
        lucide.createIcons();
      }

      var path = window.location.pathname;
      document.querySelectorAll('.navbar-links a, .mobile-menu a').forEach(function (a) {
        var href = a.getAttribute('href');
        var active = href === '/' ? path === '/' : path === href || path.indexOf(href + '/') === 0;
        if (active) a.classList.add('active');
      });

      var settingsBtn = document.getElementById('settingsBtn');
      var settingsMenu = document.getElementById('settings-menu');
      if (settingsBtn && settingsMenu) {
        var closeSettings = function () {
          settingsMenu.hidden = true;
          settingsBtn.setAttribute('aria-expanded', 'false');
        };
        settingsBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = settingsMenu.hidden;
          settingsMenu.hidden = !open;
          settingsBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', function (e) {
          if (!settingsMenu.hidden && !settingsMenu.contains(e.target)) closeSettings();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !settingsMenu.hidden) {
            closeSettings();
            settingsBtn.focus();
          }
        });

        var THEME_KEY = 'ps99-theme';
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        var themeOptions = document.querySelectorAll('[data-theme-option]');
        var themeTransitionTimer = null;

        var applyTheme = function (choice, skipTransition) {
          var root = document.documentElement;
          if (!skipTransition) {
            root.classList.add('theme-transition');
            clearTimeout(themeTransitionTimer);
            themeTransitionTimer = setTimeout(function () {
              root.classList.remove('theme-transition');
            }, 300);
          }
          if (choice === 'light' || (choice === 'system' && !systemDark.matches)) {
            root.dataset.theme = 'light';
          } else {
            delete root.dataset.theme;
          }
          themeOptions.forEach(function (btn) {
            btn.setAttribute('aria-checked', String(btn.dataset.themeOption === choice));
          });
        };

        var stored = 'dark';
        try { stored = localStorage.getItem(THEME_KEY) || 'dark'; } catch (e) { /* default */ }
        applyTheme(stored, true);

        themeOptions.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var choice = btn.dataset.themeOption;
            try { localStorage.setItem(THEME_KEY, choice); } catch (e) { /* non-persistent */ }
            applyTheme(choice);
            closeSettings();
          });
        });

        systemDark.addEventListener('change', function () {
          var current = 'dark';
          try { current = localStorage.getItem(THEME_KEY) || 'dark'; } catch (e) { /* default */ }
          if (current === 'system') applyTheme('system');
        });
      }

      var hamburgerBtn = document.getElementById('hamburgerBtn');
      var mobileMenu = document.getElementById('mobile-menu');
      var mobileSettingsBtn = document.getElementById('mobileSettingsBtn');
      var mobileSettings = document.getElementById('mobile-settings');
      var collapseMobileSettings = function () {
        if (mobileSettings && mobileSettingsBtn) {
          mobileSettings.hidden = true;
          mobileSettingsBtn.setAttribute('aria-expanded', 'false');
        }
      };
      if (hamburgerBtn && mobileMenu) {
        var closeMobileMenu = function () {
          mobileMenu.classList.remove('open');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          collapseMobileSettings();
        };
        hamburgerBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (mobileMenu.classList.contains('open')) {
            closeMobileMenu();
            return;
          }
          mobileMenu.classList.add('open');
          hamburgerBtn.setAttribute('aria-expanded', 'true');
        });
        document.addEventListener('click', function (e) {
          if (mobileMenu.classList.contains('open') && !mobileMenu.contains(e.target)) {
            closeMobileMenu();
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
            closeMobileMenu();
            hamburgerBtn.focus();
          }
        });
        mobileMenu.addEventListener('click', function (e) {
          if (e.target.closest('a')) closeMobileMenu();
        });
      }
      if (mobileSettingsBtn && mobileSettings) {
        mobileSettingsBtn.addEventListener('click', function () {
          var open = mobileSettings.hidden;
          mobileSettings.hidden = !open;
          mobileSettingsBtn.setAttribute('aria-expanded', String(open));
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderIcons);
      } else {
        renderIcons();
      }
    })();
  </script>
