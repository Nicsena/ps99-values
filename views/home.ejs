<%- include('partials/header', { title: 'PS99 Values' }) %>

<section class="home-hero">
  <h1 class="home-title">PS99 Values</h1>
  <p class="home-sub">Hourly RAP and exists tracking for Pet Simulator 99 — free, fast, and pulled straight from the BIG Games public API.</p>
  <div class="home-actions">
    <a href="/items" class="btn btn-accent">Browse Items</a>
  </div>
  <div class="home-hero-meta muted">
    <span><b><%= itemCount.toLocaleString() %></b> items</span>
    <span class="stat-sep">&middot;</span>
    <span>hourly snapshots</span>
    <span class="stat-sep">&middot;</span>
    <span>synced <span id="home-sync" data-sync="<%= lastSyncAt %>" class="home-sync-inline">&mdash;</span></span>
  </div>
</section>

<section class="home-features">
  <div class="feature-row">
    <i data-lucide="chart-line" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>RAP history charts</b>
      <p class="muted">Every item charts its Recent Average Price over time — line, bar, or area, with ranges from 1 day to all-time.</p>
    </div>
  </div>
  <div class="feature-row">
    <i data-lucide="boxes" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>Supply tracking</b>
      <p class="muted">Exists counts tracked for every variant, with supply filters to find the rarest items in the game.</p>
    </div>
  </div>
  <div class="feature-row">
    <i data-lucide="sparkles" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>Every variant, first-class</b>
      <p class="muted">Golden, Rainbow, Shiny, and Chroma each get their own page, price, and history.</p>
    </div>
  </div>
  <div class="feature-row">
    <i data-lucide="search" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>Instant search</b>
      <p class="muted">Press <kbd class="search-slash-hint">/</kbd> anywhere to search across all tracked items instantly.</p>
    </div>
  </div>
  <div class="feature-row">
    <i data-lucide="sliders-horizontal" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>Sort &amp; filter</b>
      <p class="muted">Slice the market by RAP, exists, rarity, shiny, or collection on the items page.</p>
    </div>
  </div>
  <div class="feature-row">
    <i data-lucide="refresh-cw" class="feature-icon" aria-hidden="true"></i>
    <div>
      <b>Fresh hourly data</b>
      <p class="muted">Snapshots sync every hour from the BIG Games public API - no login, no paywall.</p>
    </div>
  </div>
</section>

<script>
  // Inlined copies of the formatters from /public/js/format.js so this
  // template doesn't need to read from a global. The /js/format.js script
  // also defines these; the duplication is intentional — this template is
  // self-contained.

  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function relTime(iso) {
    if (!iso) return null;
    var d = new Date(iso);
    if (isNaN(d.getTime())) return null;
    var secs = Math.max(0, Math.floor((Date.now() - d.getTime()) / 1000));
    if (secs < 60) return 'just now';
    if (secs < 3600) return Math.floor(secs / 60) + 'm ago';
    var hours = Math.floor(secs / 3600);
    if (hours < 24) return hours + 'h ago';
    return Math.floor(hours / 24) + 'd ago';
  }

  function fmtDateTime(iso) {
    if (!iso) return '\u2014';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '\u2014';
    var h = d.getHours();
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    return (
      MONTHS[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear() +
      ', ' + h + ':' + String(d.getMinutes()).padStart(2, '0') + ' ' + ampm
    );
  }

  (function () {
    function hydrate() {
      var el = document.getElementById('home-sync');
      if (!el) return;
      var iso = el.getAttribute('data-sync');
      if (iso) {
        el.textContent = relTime(iso);
        el.title = fmtDateTime(iso);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrate);
    } else {
      hydrate();
    }
  })();
</script>

<%- include('partials/footer') %>
