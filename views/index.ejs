<%- include('partials/header', { title: 'Pets' }) %>

<section class="page-head">
  <h1>Pet Values</h1>
  <p class="muted"><%= total %> items found</p>
</section>

<form method="get" action="/" class="search-form">
  <% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
  <% if (order) { %><input type="hidden" name="order" value="<%= order %>"><% } %>
  <input type="text" name="q" value="<%= search %>" placeholder="Search pets..." class="input">
  <button type="submit" class="btn">Search</button>
</form>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>
          <% const nextNameOrder = sort === 'name' && order === 'asc' ? 'desc' : 'asc'; %>
          <a class="sort-link <%= sort === 'name' ? 'active' : '' %>" href="/?sort=name&order=<%= nextNameOrder %>&q=<%= encodeURIComponent(search) %>&page=1">Name <%= sort === 'name' ? (order === 'asc' ? '▲' : '▼') : '' %></a>
        </th>
        <th>Category</th>
        <th>Variant</th>
        <th>Collection</th>
        <th class="num">
          <% const nextRapOrder = sort === 'rap' && order === 'asc' ? 'desc' : 'asc'; %>
          <a class="sort-link <%= sort === 'rap' ? 'active' : '' %>" href="/?sort=rap&order=<%= nextRapOrder %>&q=<%= encodeURIComponent(search) %>&page=1">RAP <%= sort === 'rap' ? (order === 'asc' ? '▲' : '▼') : '' %></a>
        </th>
      </tr>
    </thead>
    <tbody>
      <% if (items.length === 0) { %>
        <tr><td colspan="5" class="empty">No results</td></tr>
      <% } %>
      <% items.forEach(function (item) {
           const variantNames = ['Normal', 'Golden', 'Rainbow'];
           const variant = variantNames[item.pt] || 'Normal';
           const badgeClass = item.pt === 1 ? 'golden' : item.pt === 2 ? 'rainbow' : '';
      %>
        <tr>
          <td>
            <a class="item-link" href="/items/<%= detailPath(item.name, item.pt || 0, !!item.shiny) %>"><%= item.name %></a>
            <% if (item.shiny) { %><span class="badge shiny">Shiny</span><% } %>
          </td>
          <td><%= item.category %></td>
          <td><span class="badge <%= badgeClass %>"><%= variant %><%= item.shiny ? ' Shiny' : '' %></span></td>
          <td><%= item.collectionName %></td>
          <td class="num rap"><%= item.rap === null ? '—' : item.rap.toLocaleString() %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
  <nav class="pagination">
    <% if (page > 1) { %>
      <a class="btn btn-ghost" href="/?sort=<%= sort %>&order=<%= order %>&q=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">&laquo; Prev</a>
    <% } else { %>
      <span class="btn btn-ghost disabled">&laquo; Prev</span>
    <% } %>

    <span class="page-info">Page <%= page %> of <%= totalPages %></span>

    <% if (page < totalPages) { %>
      <a class="btn btn-ghost" href="/?sort=<%= sort %>&order=<%= order %>&q=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">Next &raquo;</a>
    <% } else { %>
      <span class="btn btn-ghost disabled">Next &raquo;</span>
    <% } %>
  </nav>
<% } %>

<%- include('partials/footer') %>
